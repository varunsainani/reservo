# ---------------------------------------------------------------------------
# Reservo — frontend environment
# Copy to .env.local for local dev. Secrets are never committed.
# ---------------------------------------------------------------------------

# Where the Next.js rewrite proxies "/api/*" and "/health" (the Express backend).
# In production this is the deployed backend URL; locally the dev backend port.
API_PROXY_TARGET="http://localhost:4000"

# Public origin of THIS frontend app. Used for metadataBase (canonical/OG URLs)
# and is the base the backend builds checkout URLs from (must match APP_URL there).
APP_URL="http://localhost:3000"

# Base URL the browser API client (src/lib/api.ts) prefixes onto every request.
# Leave it EMPTY (the normal setup) to use the same-origin "/api" proxy, where the
# Next.js rewrite forwards "/api/*" to API_PROXY_TARGET. Only set this to an
# absolute backend origin if you call the API cross-origin instead of via the proxy.
NEXT_PUBLIC_API_URL=""

# One-click demo credentials (seeded accounts, password "demo1234"). These are
# NEXT_PUBLIC_* so the login/register pages can offer instant demo sign-in.
NEXT_PUBLIC_DEMO_CUSTOMER_EMAIL="customer@reservo.app"
NEXT_PUBLIC_DEMO_CUSTOMER_PASSWORD="demo1234"
NEXT_PUBLIC_DEMO_PROVIDER_EMAIL="provider@reservo.app"
NEXT_PUBLIC_DEMO_PROVIDER_PASSWORD="demo1234"
NEXT_PUBLIC_DEMO_ADMIN_EMAIL="admin@reservo.app"
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD="demo1234"
