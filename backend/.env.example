# ── Database (Neon Postgres) ───────────────────────────────────────────────
# Pooled connection (used at runtime by the app / Prisma Client).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Direct connection (used for migrations / db push / introspection).
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# ── Auth ───────────────────────────────────────────────────────────────────
# REQUIRED in production. A long random string. Refresh tokens are random
# hashes (not derived from this), so rotating it only invalidates access JWTs.
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
# Access-token lifetime. e.g. 30m, 1h, 15m. Default 30m.
ACCESS_TOKEN_TTL="30m"

# ── Payments ───────────────────────────────────────────────────────────────
# "simulated" (default, no external account) or "mercadopago".
PAYMENT_PROVIDER="simulated"
# Shared secret the simulated checkout uses to authenticate webhook calls.
SIMULATED_WEBHOOK_TOKEN="change-me-simulated-webhook-token"
# How long an unpaid booking holds its slot, in minutes. Default 15.
HOLD_MINUTES="15"

# MercadoPago (only needed when PAYMENT_PROVIDER=mercadopago).
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

# ── App / CORS ─────────────────────────────────────────────────────────────
# Public base URL of the frontend (used to build checkout URLs).
APP_URL="http://localhost:3000"
# Allowed CORS origin(s), comma-separated. "*" is allowed in dev only; in prod
# an unset/"*" value falls back to APP_URL (non-fatal warning).
CORS_ORIGIN="*"

# ── Cron ───────────────────────────────────────────────────────────────────
# Shared secret guarding POST /api/cron/release-expired (x-cron-secret header).
CRON_SECRET="change-me-cron-secret"

# ── Runtime ────────────────────────────────────────────────────────────────
PORT="4000"
NODE_ENV="development"

# ── Optional email (silently skipped if unset) ─────────────────────────────
# Brevo single-sender or generic SMTP. Either set BREVO_* or SMTP_*.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
